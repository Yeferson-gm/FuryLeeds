{
  "name": "furyleeds",
  "version": "0.8.0",
  "private": true,
  "description": "CRM en español para gestionar conversaciones, contactos, ventas, difusiones y automatizaciones de WhatsApp.",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "bun run server.ts",
    "build": "next build",
    "start": "NODE_ENV=production bun run server.ts",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test --parallel --preload ./test/setup.ts ./test",
    "test:watch": "bun test --watch --parallel --preload ./test/setup.ts ./test",
    "test:external": "sh ./test/test.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dagrejs/dagre": "^3.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@xyflow/react": "^12.11.3",
    "better-auth": "^1.7.5",
    "boneyard-js": "^1.10.0",
    "drizzle-orm": "^0.45.3",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "opus-recorder": "^8.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "sileo": "^0.1.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.28",
    "tailwindcss": "^4",
    "typescript": "7.0.2"
  },
  "overrides": {
    "ip-address": "^10.3.1",
    "fast-uri": "^3.1.6",
    "hono": "^4.13.5",
    "js-yaml": "^4.3.2",
    "nanoid": "^3.3.17",
    "@babel/core": "^7.29.6",
    "brace-expansion@^1.0.0": "^1.1.18",
    "brace-expansion@^5.0.0": "^5.0.9"
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core"
  ],
  "engines": {
    "bun": ">=1.4.0"
  }
}
